{
  "manifest_version": 3,
  "name": "AI Workflow Studio",
  "description": "Project-based batch prompt runner for AI image generation.",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "action": { "default_popup": "popup.html", "default_title": "AI Workflow Studio" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://grok.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://grok.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"],
  "commands": {
    "open-studio": { "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" }, "description": "Open Workflow Studio" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" }
}
